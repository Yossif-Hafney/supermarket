generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_drawer {
  drawer_id       Int      @id @default(1) @db.SmallInt
  opening_balance Decimal  @db.Decimal(12, 2)
  opening_date    DateTime @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_movement {
  movement_id     Int      @id @default(autoincrement())
  movement_data   DateTime @default(now()) @db.Timestamptz(6)
  movement_amount Decimal  @db.Decimal(12, 2)
  movement_reason String?  @default("NO REASON") @db.VarChar(250)
  movement_type   String   @db.VarChar(20)
  direction       String   @db.VarChar(3)
  payment_id      Int?     @unique
  sale_id         Int?     @unique
  expense_id      Int?     @unique
  expense         expense? @relation(fields: [expense_id], references: [expense_id], onDelete: NoAction, onUpdate: NoAction)
  payment         payment? @relation(fields: [payment_id], references: [payment_id], onDelete: NoAction, onUpdate: NoAction)
  sale            sale?    @relation(fields: [sale_id], references: [sale_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expense {
  expense_id          Int            @id @default(autoincrement())
  expense_data        DateTime       @default(now()) @db.Timestamptz(6)
  expense_amount      Decimal        @db.Decimal(12, 2)
  expense_description String?        @default("NO DATA") @db.VarChar(150)
  expense_category    String         @db.VarChar(50)
  cash_movement       cash_movement?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payment {
  payment_id     Int            @id @default(autoincrement())
  payment_data   DateTime       @default(now()) @db.Timestamptz(6)
  payment_amount Decimal        @db.Decimal(12, 2)
  purchase_id    Int
  cash_movement  cash_movement?
  purchase       purchase       @relation(fields: [purchase_id], references: [purchase_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product {
  product_id                  Int                @id @default(autoincrement())
  product_name                String             @db.VarChar(75)
  product_description         String?            @default("NO DATA") @db.VarChar(150)
  product_selling_price       Decimal            @db.Decimal(12, 2)
  product_unit_of_measurement String             @db.VarChar(30)
  min_stock_level             Int
  created_at                  DateTime           @default(now()) @db.Timestamptz(6)
  is_active                   Boolean            @default(true)
  product_purchase            product_purchase[]
  product_sale                product_sale[]
  stock_movement              stock_movement[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_purchase {
  purchase_id    Int
  product_id     Int
  quantity       Int
  unit_cost      Decimal          @db.Decimal(12, 2)
  product        product          @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  purchase       purchase         @relation(fields: [purchase_id], references: [purchase_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movement stock_movement[]

  @@id([purchase_id, product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_sale {
  sale_id        Int
  product_id     Int
  quantity       Int
  sale_price     Decimal          @db.Decimal(12, 2)
  product        product          @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  sale           sale             @relation(fields: [sale_id], references: [sale_id], onDelete: NoAction, onUpdate: NoAction)
  stock_movement stock_movement[]

  @@id([sale_id, product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase {
  purchase_id      Int                @id @default(autoincrement())
  purchase_date    DateTime           @default(now()) @db.Timestamptz(6)
  receive_date     DateTime?          @db.Timestamptz(6)
  supplier_id      Int
  status           String             @default("ORDERED") @db.VarChar(10)
  payment          payment[]
  product_purchase product_purchase[]
  supplier         supplier           @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sale {
  sale_id       Int            @id @default(autoincrement())
  sale_date     DateTime       @default(now()) @db.Timestamptz(6)
  status        String?        @default("DRAFT") @db.VarChar(20)
  cash_movement cash_movement?
  product_sale  product_sale[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_movement {
  movement_id      Int               @id @default(autoincrement())
  movement_data    DateTime          @default(now()) @db.Timestamptz(6)
  movement_reason  String            @db.VarChar(250)
  quantity_change  Decimal           @db.Decimal(12, 3)
  movement_type    String            @db.VarChar(20)
  direction        String            @db.VarChar(3)
  product_id       Int
  purchase_id      Int?
  sale_id          Int?
  product          product           @relation(fields: [product_id], references: [product_id], onUpdate: NoAction)
  product_purchase product_purchase? @relation(fields: [purchase_id, product_id], references: [purchase_id, product_id], onUpdate: NoAction)
  product_sale     product_sale?     @relation(fields: [sale_id, product_id], references: [sale_id, product_id], onUpdate: NoAction)
}

model supplier {
  supplier_id      Int              @id @default(autoincrement())
  supplier_address String?          @default("NO ADDRESS") @db.VarChar(100)
  supplier_name    String           @db.VarChar(30)
  purchase         purchase[]
  supplier_phone   supplier_phone[]
}

model supplier_phone {
  supplier_phone String   @db.VarChar(30)
  supplier_id    Int
  supplier       supplier @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([supplier_id, supplier_phone])
}
